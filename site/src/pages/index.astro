---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const demo = `${base}/demo/`;
const gh = "https://github.com/juandresrodca/IntuneGraph";
const features = [
  {
    cmd: "Get-IntuneTarget",
    q: 'What applies to this device — and why?',
    body: "Resolve every policy, app and script that targets a device or user, with the exact group path that causes each — through nesting, filters and include/exclude.",
    code: `PS> Get-IntuneTarget -Identity DEV-FIN-01

Workload                 Status            Via
Win11 Security Baseline  Applies           DEV-FIN-01 -> SG-Finance -> SG-AllStaff
Win Compliance           AppliesPreFilter  DEV-FIN-01 -> All Devices  (F-CorpOwned)
LOB Finance App          Applies           DEV-FIN-01 -> SG-Finance`,
  },
  {
    cmd: "Get-IntuneBlastRadius",
    q: "What breaks if I touch this group?",
    body: "Preview the impact of a membership change before you make it — exactly which workloads a device or user gains or loses, resolved through nesting and exclusions.",
    code: `PS> Get-IntuneBlastRadius -Group SG-Finance -WhatIfAddMember KIOSK-01

Adding 'KIOSK-01' to 'SG-Finance':
  Gains 3 workload(s), loses 0.`,
  },
  {
    cmd: "Find-IntuneOrphan",
    q: "What's assigned to nothing — or broken?",
    body: "Scan the whole tenant for assignment hygiene problems: dead config, empty and deleted target groups, include/exclude collisions, and mixed device/user targeting.",
    code: `PS> Find-IntuneOrphan

BrokenGroupReference    High     Old CRM             (targets a deleted group)
IncludeExcludeCollision High     Legacy VPN Profile  (included AND excluded)
EmptyTarget             Warning  Kiosk Lockdown      (empty group)`,
  },
];
const compare = [
  ["“What applies to X” list", 1, 1, 0],
  ["Membership path (why)", 1, 0, 0],
  ["Blast-radius / change impact", 1, 0, 0],
  ["Assignment hygiene checks", 1, 0.5, 0],
  ["Interactive graph", 1, 0, 0],
  ["Config backup / as-code", 0, 0, 1],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IntuneGraph — your Intune tenant as a relationship graph</title>
    <meta name="description" content="Turn your Microsoft Intune tenant into an interactive relationship graph. Target resolution, blast-radius impact preview, and assignment hygiene checks. Read-only, offline-capable." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content="IntuneGraph — your Intune tenant as a relationship graph" />
    <meta property="og:description" content="Target resolution, blast-radius impact preview, and assignment hygiene — from a local, read-only snapshot." />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="grid-bg"></div>

    <nav>
      <a class="brand" href={base + "/"}><span class="dia">◆</span> IntuneGraph</a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#demo">Live demo</a>
        <a href="#install">Install</a>
        <a class="gh" href={gh} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </nav>

    <header class="hero">
      <div class="pills">
        <span class="pill lv">◆ Intune · PowerShell</span>
        <span class="pill">Read-only · zero write scopes</span>
        <span class="pill lv">Offline demo</span>
        <span class="pill">MIT</span>
      </div>
      <h1>Intune tenant as an<br /><span>interactive relationship graph</span></h1>
      <p class="lede">
        Assignments <em>are</em> a graph — groups nest, filters narrow, includes and excludes
        fight. Every other tool shows you flat lists. IntuneGraph makes the graph the data model,
        so the questions admins actually ask become simple queries.
      </p>
      <div class="cta">
        <a class="btn primary" href={demo}>Open the live demo →</a>
        <a class="btn ghost" href={gh} target="_blank" rel="noopener">★ Star on GitHub</a>
      </div>

      <div class="window">
        <div class="win-bar">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="win-title">IntuneGraph — Contoso demo tenant</span>
          <a class="win-open" href={demo}>open ↗</a>
        </div>
        <iframe src={demo} title="IntuneGraph live demo" loading="lazy"></iframe>
      </div>
    </header>

    <section id="features" class="section">
      <h2 class="sec-h"><span class="d"></span>The three questions it answers</h2>
      <div class="feat-grid">
        {features.map((f) => (
          <article class="card">
            <div class="cmd">{f.cmd}</div>
            <h3>{f.q}</h3>
            <p>{f.body}</p>
            <pre>{f.code}</pre>
          </article>
        ))}
      </div>
    </section>

    <section id="demo" class="section">
      <h2 class="sec-h"><span class="d"></span>Try it — no tenant needed</h2>
      <p class="sec-lede">
        The bundled <b>Contoso</b> demo tenant runs entirely in your browser. Drag nodes, zoom,
        click for details. The whole tool works offline against demo data — so you can evaluate
        it (and contribute to it) without ever touching a real tenant.
      </p>
      <div class="window tall">
        <div class="win-bar">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="win-title">graph.html — self-contained, zero network calls</span>
          <a class="win-open" href={demo}>fullscreen ↗</a>
        </div>
        <iframe src={demo} title="IntuneGraph live demo full" loading="lazy"></iframe>
      </div>
    </section>

    <section class="section">
      <h2 class="sec-h"><span class="d"></span>How it stacks up</h2>
      <p class="sec-lede">
        Not another config-backup tool — the relationship-and-impact layer. The excellent tools
        below solve adjacent problems; use them together.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th></th><th class="me">IntuneGraph</th><th>Assignment&nbsp;Checker</th><th>IntuneCD</th><th>Portal</th></tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <td class="rowlbl">{row[0]}</td>
                {row.slice(1).map((v, i) => (
                  <td class={i === 0 ? "me" : ""}>{v === 1 ? "●" : v === 0.5 ? "◐" : "—"}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="install" class="section">
      <h2 class="sec-h"><span class="d"></span>Install &amp; run</h2>
      <div class="install-grid">
        <div>
          <div class="step">1 · Zero-setup demo</div>
          <pre class="run">Install-Module IntuneGraph -Scope CurrentUser
Import-Module IntuneGraph
Export-IntuneGraph -DemoData -PassThru | Show-IntuneGraph -Open</pre>
        </div>
        <div>
          <div class="step">2 · Your tenant (read-only)</div>
          <pre class="run">Connect-IntuneGraph
Export-IntuneGraph -Html -PassThru | Show-IntuneGraph -Open
Get-IntuneTarget      -Identity DESKTOP-01
Get-IntuneBlastRadius -Group   "SG-Finance"
Find-IntuneOrphan</pre>
        </div>
      </div>
      <p class="note">
        Four read-only Graph scopes, zero write scopes — the code contains no POST/PATCH/DELETE
        paths. Your data never leaves the <code>graph.json</code> you export.
      </p>
    </section>

    <footer>
      <div class="foot-in">
        <span><span class="dia">◆</span> IntuneGraph — MIT</span>
        <span class="dim">Not affiliated with Microsoft. Read-only reporting tool; always verify changes in the Intune portal.</span>
        <a href={gh} target="_blank" rel="noopener">github.com/juandresrodca/IntuneGraph ↗</a>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg:#0a0e16; --bg2:#0d1320; --panel:#111a2b; --panel2:#16213a;
        --line:#1e2c45; --line2:#27395a;
        --green:#9fef00; --green-dim:#6fa800; --blue:#58a6ff; --purple:#c792ea;
        --cyan:#56d4dd; --red:#ff7b72; --amber:#ffb454;
        --txt:#c9d4e3; --dim:#7c8aa0; --mute:#56657d;
        --mono:'JetBrains Mono',ui-monospace,monospace;
        --sans:'Outfit',system-ui,-apple-system,'Segoe UI',sans-serif;
      }
      * { box-sizing:border-box; margin:0; padding:0; }
      html { scroll-behavior:smooth; }
      body {
        font-family:var(--sans); color:var(--txt); line-height:1.6; font-size:15px;
        background:
          radial-gradient(1000px 560px at 88% -12%, rgba(88,166,255,.10), transparent 60%),
          radial-gradient(820px 560px at -6% 108%, rgba(159,239,0,.06), transparent 55%),
          var(--bg);
        min-height:100vh; overflow-x:hidden;
      }
      .grid-bg { position:fixed; inset:0; z-index:0; pointer-events:none;
        background-image:linear-gradient(rgba(40,57,90,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(40,57,90,.14) 1px,transparent 1px);
        background-size:44px 44px; mask-image:radial-gradient(circle at 60% 12%,#000,transparent 82%); }
      nav, .hero, .section, footer { position:relative; z-index:1; }
      a { color:inherit; text-decoration:none; }
      .dia { color:var(--green); }

      /* nav */
      nav { max-width:1120px; margin:0 auto; display:flex; align-items:center; justify-content:space-between;
        padding:20px 24px; }
      .brand { font-family:var(--mono); font-weight:700; font-size:16px; letter-spacing:-.3px; }
      .nav-links { display:flex; gap:22px; font-family:var(--mono); font-size:13px; color:var(--dim); }
      .nav-links a:hover { color:var(--txt); }
      .nav-links .gh { color:var(--green); }

      /* hero */
      .hero { max-width:1120px; margin:0 auto; padding:40px 24px 20px; text-align:center; }
      .pills { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:26px; }
      .pill { font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.5px;
        color:var(--dim); background:#0e1626; border:1px solid var(--line2); border-radius:6px; padding:4px 10px; }
      .pill.lv { color:var(--green); border-color:rgba(159,239,0,.35); background:rgba(159,239,0,.06); }
      h1 { font-size:clamp(30px,5.2vw,52px); line-height:1.1; font-weight:700; letter-spacing:-1.2px; }
      h1 .hl { color:var(--green); }
      .lede { max-width:660px; margin:20px auto 0; color:var(--dim); font-size:clamp(15px,2vw,17px); }
      .lede em { color:var(--txt); font-style:normal; }
      .cta { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin:28px 0 40px; }
      .btn { font-family:var(--mono); font-size:14px; font-weight:600; padding:12px 22px; border-radius:10px;
        border:1px solid transparent; transition:.15s; cursor:pointer; }
      .btn.primary { background:var(--green); color:var(--bg); box-shadow:0 8px 30px rgba(159,239,0,.18); }
      .btn.primary:hover { filter:brightness(1.08); transform:translateY(-1px); }
      .btn.ghost { color:var(--txt); border-color:var(--line2); background:rgba(22,33,58,.5); }
      .btn.ghost:hover { border-color:var(--green); color:var(--green); }

      /* browser window frame */
      .window { max-width:1000px; margin:0 auto; border:1px solid var(--line2); border-radius:14px; overflow:hidden;
        background:var(--panel); box-shadow:0 30px 80px rgba(0,0,0,.55); }
      .win-bar { display:flex; align-items:center; gap:8px; padding:11px 14px; background:linear-gradient(180deg,var(--panel2),var(--panel));
        border-bottom:1px solid var(--line); }
      .win-bar .dot { width:11px; height:11px; border-radius:50%; }
      .win-bar .dot.r { background:#ff5f57; } .win-bar .dot.y { background:#febc2e; } .win-bar .dot.g { background:#28c840; }
      .win-title { font-family:var(--mono); font-size:12px; color:var(--dim); margin-left:8px; }
      .win-open { font-family:var(--mono); font-size:11px; color:var(--green); margin-left:auto; }
      .win-open:hover { text-decoration:underline; }
      .window iframe { display:block; width:100%; height:460px; border:0; background:var(--bg); }
      .window.tall iframe { height:600px; }

      /* sections */
      .section { max-width:1120px; margin:0 auto; padding:64px 24px; }
      .sec-h { font-family:var(--mono); font-size:13px; text-transform:uppercase; letter-spacing:1.2px; color:var(--txt);
        display:flex; align-items:center; gap:10px; margin-bottom:14px; }
      .sec-h .d { width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 9px var(--green); }
      .sec-lede { color:var(--dim); max-width:680px; margin-bottom:26px; }
      .sec-lede b { color:var(--txt); }

      /* feature cards */
      .feat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
      @media(max-width:900px){ .feat-grid{ grid-template-columns:1fr; } }
      .card { background:linear-gradient(180deg,var(--panel),var(--bg2)); border:1px solid var(--line); border-radius:14px;
        padding:20px; transition:.18s; }
      .card:hover { border-color:var(--line2); transform:translateY(-2px); }
      .card .cmd { font-family:var(--mono); font-size:12px; color:var(--green); background:rgba(159,239,0,.06);
        border:1px solid rgba(159,239,0,.25); border-radius:6px; padding:3px 9px; display:inline-block; }
      .card h3 { font-size:18px; margin:12px 0 8px; letter-spacing:-.3px; }
      .card p { color:var(--dim); font-size:13.5px; margin-bottom:14px; }
      .card pre, pre.run { font-family:var(--mono); font-size:11px; line-height:1.55; color:var(--txt);
        background:#0a1018; border:1px solid var(--line); border-radius:9px; padding:12px; overflow-x:auto; white-space:pre; }

      /* comparison table */
      .table-wrap { overflow-x:auto; border:1px solid var(--line); border-radius:14px; }
      table { width:100%; border-collapse:collapse; font-size:13.5px; min-width:560px; }
      th, td { padding:12px 14px; text-align:center; border-bottom:1px solid var(--line); }
      thead th { font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:var(--dim);
        background:var(--panel); }
      th.me, td.me { color:var(--green); }
      td.me { font-weight:600; }
      .rowlbl { text-align:left; color:var(--txt); }
      tbody tr:last-child td { border-bottom:none; }
      tbody td { color:var(--mute); }

      /* install */
      .install-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
      @media(max-width:820px){ .install-grid{ grid-template-columns:1fr; } }
      .step { font-family:var(--mono); font-size:12px; color:var(--amber); margin-bottom:9px; }
      .note { color:var(--mute); font-size:13px; margin-top:18px; }
      .note code, .card code { font-family:var(--mono); background:#0c1422; padding:1px 6px; border-radius:4px; font-size:12px; }

      /* footer */
      footer { border-top:1px solid var(--line); margin-top:40px; }
      .foot-in { max-width:1120px; margin:0 auto; padding:26px 24px; display:flex; gap:16px; flex-wrap:wrap;
        align-items:center; justify-content:space-between; font-family:var(--mono); font-size:12px; }
      .foot-in .dim { color:var(--mute); max-width:520px; }
      .foot-in a { color:var(--green); }
    </style>
  </body>
</html>
